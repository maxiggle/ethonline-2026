{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "typeRoots": [
      "./backend/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*"
  ],
  "exclude": [
    "backend",
    "chapter2",
    "node_modules"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
